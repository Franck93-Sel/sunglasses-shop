    {
      "id": "ba3c916d-5338-4cbd-b52f-cb7270bf9298",
      "name": "Enregistrer Commande (Neon)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        60
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "with new_order as (\n  insert into app.orders (email, total, stripe_session_id)\n  values (nullif($1, ''), round($2::numeric / 100, 2), $3)\n  on conflict (stripe_session_id) do nothing\n  returning id, order_number\n), new_items as (\n  insert into app.order_items (order_id, product_name, unit_price, quantity)\n  select o.id, li.description, round(li.amount_total::numeric / li.quantity / 100, 2), li.quantity\n  from new_order o\n  cross join jsonb_to_recordset($4::jsonb) as li(description text, amount_total bigint, quantity int)\n  returning id\n)\nselect (select id from new_order) as order_id,\n       (select order_number from new_order) as order_number,\n       (select count(*) from new_items)::int as items_inserted",
        "options": {
          "queryReplacement": "={{ $('Vérifier Session (Stripe)').item.json.customer_details?.email || $('Vérifier Session (Stripe)').item.json.customer_email || '' }}, {{ $('Vérifier Session (Stripe)').item.json.amount_total }}, {{ $('Vérifier Session (Stripe)').item.json.id }}, {{ JSON.stringify($json.data.map(li => ({ description: li.description, amount_total: li.amount_total, quantity: li.quantity }))) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "V0ZMCCxh2dSUoJN6",
          "name": "Postgres account"
        }
      }
    },
