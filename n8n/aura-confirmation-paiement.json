      },
      "credentials": {
        "httpBearerAuth": {
          "id": "C44ly21Yw1BFymeU",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "id": "54643f2b-3647-4518-a473-fc057c434f1a",
      "name": "Paiement confirmé ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.payment_status }}",
              "rightValue": "paid",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "434ced0d-8dd1-4eb9-aacd-234d071c2002",
      "name": "Récupérer Articles (Stripe)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        80
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "=https://api.stripe.com/v1/checkout/sessions/{{ $json.id }}/line_items?limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {}
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "C44ly21Yw1BFymeU",
          "name": "Bearer Auth account"
        }
