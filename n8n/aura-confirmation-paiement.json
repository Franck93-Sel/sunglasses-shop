    },
    {
      "id": "6ef8bb04-badb-4def-832c-b15b024afb65",
      "name": "Extraire Infos Commande",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        540,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "customerEmail",
              "value": "={{ $json.data.object.customer_details?.email }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "customerName",
              "value": "={{ String($json.data.object.customer_details?.name ?? \"Client\").replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]) }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "amountTotal",
              "value": "={{ ($json.data.object.amount_total / 100).toFixed(2) }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "currency",
              "value": "={{ ($json.data.object.currency || \"eur\").toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "sessionId",
              "value": "={{ $json.data.object.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e32abbbd-4865-428d-8993-45d08280d84f",
      "name": "Envoyer Email Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.customerEmail }}",
        "subject": "Confirmation de votre commande AURA",
        "emailType": "html",
        "message": "=<div style=\"font-family: Georgia, serif; background:#0a0a0a; color:#ffffff; padding:40px;\"><h1 style=\"color:#cfa15f; font-weight:normal;\">AURA</h1><p>Bonjour {{ $json.customerName }},</p><p>Merci pour votre commande. Votre paiement de <strong>{{ $json.amountTotal }} {{ $json.currency }}</strong> a bien été confirmé.</p><p style=\"color:#a0a0a0; font-size:0.9em;\">Référence de commande : {{ $json.sessionId }}</p><p>Votre monture sera préparée avec le plus grand soin.</p><p style=\"margin-top:40px; color:#a0a0a0;\">— L'équipe AURA</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "Gg4MhaOfLEeJUVcS",
          "name": "Gmail account"
        }
      },
      "webhookId": "ba203c6a-fc69-4505-87f2-18d1aaa775df"
    },
    {
      "id": "ca592c5d-45f4-4039-acf2-d600697219d9",
