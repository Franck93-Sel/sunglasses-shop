    {
      "id": "7d1f3c2a-0b1e-4a51-9a10-000000000002",
      "name": "Valider orderId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// orderId doit être un entier strictement positif (nombre ou chaîne de chiffres). Tout le reste est rejeté.\nconst raw = $('Commande expédiée (Webhook)').first().json.body?.orderId;\nlet orderId = null;\nif (typeof raw === 'number' && Number.isSafeInteger(raw) && raw > 0) orderId = raw;\nelse if (typeof raw === 'string' && /^[1-9][0-9]{0,14}$/.test(raw)) orderId = Number(raw);\nreturn [{ json: { valid: orderId !== null, orderId } }];"
      }
    },
    {
      "id": "7d1f3c2a-0b1e-4a51-9a10-000000000003",
      "name": "orderId valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7d1f3c2a-0b1e-4a51-9a10-000000000006",
      "name": "Marquer email envoyé (Neon)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        180
      ],
      "alwaysOutputData": true,
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Garde atomique : seule cette requête décide si un email part (R9) ; appelant déjà vérifié admin « all ».\nwith upd as (\n  update app.orders\n     set shipped_email_sent_at = now()\n   where id = $1\n     and status = 'expediee'\n     and shipped_email_sent_at is null\n  returning id, order_number, email, total, tracking_number, shipped_email_sent_at::text as sent_at\n)\nselect u.id, u.order_number, u.email, u.total, u.tracking_number, u.sent_at,\n       coalesce((select json_agg(json_build_object('name', i.product_name, 'qty', i.quantity, 'price', i.unit_price) order by i.id)\n                   from app.order_items i where i.order_id = u.id), '[]'::json) as items\nfrom upd u",
        "options": {
          "queryReplacement": "={{ $('Valider orderId').first().json.orderId }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "V0ZMCCxh2dSUoJN6",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "7d1f3c2a-0b1e-4a51-9a10-000000000007",
      "name": "Préparer email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Aucune ligne renvoyée par la garde atomique => rien à envoyer.\nconst row = $input.first().json;\nif (!row || !row.order_number || !row.email) return [{ json: { found: false } }];\n\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst eur = (n) => Number(n).toFixed(2).replace('.', ',') + ' €';\nlet items = row.items;\nif (typeof items === 'string') items = JSON.parse(items);\nconst lines = (items || [])\n  .map((i) => `<li style=\"margin-bottom:6px;\">${esc(i.name)} × ${Number(i.qty)} — ${eur(Number(i.price) * Number(i.qty))}</li>`)\n  .join('');\n\nconst html = `<div style=\"font-family: Georgia, serif; background:#0a0a0a; color:#ffffff; padding:40px;\">`\n  + `<h1 style=\"color:#cfa15f; font-weight:normal;\">AURA</h1>`\n  + `<p>Bonjour,</p>`\n  + `<p>Bonne nouvelle : votre commande <strong>${esc(row.order_number)}</strong> vient d'être expédiée et est en route vers vous.</p>`\n  + `<ul style=\"padding-left:20px;\">${lines}</ul>`\n  + `<p>Total : <strong>${eur(row.total)}</strong></p>`\n  + `<p style=\"color:#a0a0a0; font-size:0.9em;\">Numéro de suivi : ${esc(row.tracking_number)}</p>`\n  + `<p>Suivez votre commande depuis votre espace client : <a href=\"https://franck93-sel.github.io/sunglasses-shop/compte.html\" style=\"color:#cfa15f;\">Mon compte AURA</a></p>`\n  + `<p style=\"margin-top:40px; color:#a0a0a0;\">— L'équipe AURA</p>`\n  + `</div>`;\n\nreturn [{ json: { found: true, to: row.email, html, orderId: Number(row.id), sentAt: row.sent_at } }];"
      }
    },
